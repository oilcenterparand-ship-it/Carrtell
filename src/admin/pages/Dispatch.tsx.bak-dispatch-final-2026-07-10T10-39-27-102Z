import { useEffect, useMemo, useState } from 'react';
import { assignServiceRequest, dispatchStatusLabels, getAvailableDrivers, getDispatchRequests, getFleetVehicles, updateServiceStatus } from '../services/dispatchApi';

type Row = any;

export default function Dispatch() {
  const [rows, setRows] = useState<Row[]>([]);
  const [drivers, setDrivers] = useState<Row[]>([]);
  const [fleet, setFleet] = useState<Row[]>([]);
  const [status, setStatus] = useState('all');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  async function load() {
    setLoading(true);
    setError('');
    try {
      const [requests, driverList, fleetList] = await Promise.all([
        getDispatchRequests(status),
        getAvailableDrivers(),
        getFleetVehicles(),
      ]);
      setRows(requests);
      setDrivers(driverList);
      setFleet(fleetList);
    } catch (e: any) {
      setError(e?.message || 'خطا در دریافت اطلاعات عملیات');
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { load(); }, [status]);

  const summary = useMemo(() => ({
    pending: rows.filter(r => r.status === 'pending').length,
    assigned: rows.filter(r => r.status === 'assigned').length,
    active: rows.filter(r => ['dispatched','arrived','in_service'].includes(r.status)).length,
    completed: rows.filter(r => r.status === 'completed').length,
  }), [rows]);

  async function handleAssign(row: Row, driverId: string) {
    if (!driverId) return;
    await assignServiceRequest(row.id, driverId, row.fleet_vehicle_id || undefined);
    await load();
  }

  return (
    <div className="p-4 md:p-6 space-y-6 text-white" dir="rtl">
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-black">مرکز عملیات سرویس در محل</h1>
          <p className="text-sm text-slate-400 mt-1">تخصیص سرویس‌کار، پیگیری اعزام و مدیریت وضعیت مأموریت‌ها</p>
        </div>
        <button onClick={load} className="rounded-xl bg-amber-400 px-4 py-2 font-bold text-slate-950">بروزرسانی</button>
      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <Stat title="جدید" value={summary.pending} />
        <Stat title="اختصاص داده‌شده" value={summary.assigned} />
        <Stat title="فعال" value={summary.active} />
        <Stat title="تکمیل‌شده" value={summary.completed} />
      </div>

      <div className="rounded-2xl border border-white/10 bg-slate-900/80 p-4">
        <select value={status} onChange={e => setStatus(e.target.value)} className="w-full md:w-72 rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-white outline-none focus:border-amber-400">
          <option value="all">همه وضعیت‌ها</option>
          {Object.entries(dispatchStatusLabels).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
        </select>
      </div>

      {error && <div className="rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-red-200">{error}</div>}
      {loading && <div className="text-slate-300">در حال بارگذاری...</div>}

      <div className="overflow-x-auto rounded-2xl border border-white/10 bg-slate-900/80">
        <table className="min-w-full text-sm">
          <thead className="bg-slate-950/80 text-slate-300">
            <tr>
              <th className="p-3 text-right">مشتری</th>
              <th className="p-3 text-right">خودرو</th>
              <th className="p-3 text-right">آدرس</th>
              <th className="p-3 text-right">وضعیت</th>
              <th className="p-3 text-right">سرویس‌کار</th>
              <th className="p-3 text-right">عملیات</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(row => (
              <tr key={row.id} className="border-t border-white/10 align-top">
                <td className="p-3"><b>{row.customer_name || 'بدون نام'}</b><br/><span className="text-slate-400">{row.customer_phone}</span></td>
                <td className="p-3">{row.car_name || '-'}<br/><span className="text-slate-400">{row.current_km?.toLocaleString('fa-IR')} km</span></td>
                <td className="p-3 max-w-xs text-slate-300">{row.address_text || '-'}</td>
                <td className="p-3"><span className="rounded-full bg-amber-400/10 px-3 py-1 text-amber-200">{dispatchStatusLabels[row.status as keyof typeof dispatchStatusLabels] || row.status}</span></td>
                <td className="p-3">
                  <select onChange={e => handleAssign(row, e.target.value)} defaultValue={row.driver_id || ''} className="rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-white">
                    <option value="">انتخاب سرویس‌کار</option>
                    {drivers.map(d => <option key={d.id} value={d.id}>{d.full_name || d.phone || d.id}</option>)}
                  </select>
                </td>
                <td className="p-3 space-y-2">
                  <div className="flex flex-wrap gap-2">
                    <Action label="تأیید" onClick={() => updateServiceStatus(row.id, 'approved').then(load)} />
                    <Action label="اعزام" onClick={() => updateServiceStatus(row.id, 'dispatched').then(load)} />
                    <Action label="رسیده" onClick={() => updateServiceStatus(row.id, 'arrived').then(load)} />
                    <Action label="شروع سرویس" onClick={() => updateServiceStatus(row.id, 'in_service').then(load)} />
                    <Action label="لغو" danger onClick={() => updateServiceStatus(row.id, 'cancelled').then(load)} />
                  </div>
                </td>
              </tr>
            ))}
            {!rows.length && !loading && <tr><td colSpan={6} className="p-8 text-center text-slate-400">درخواستی یافت نشد.</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}

function Stat({ title, value }: { title: string; value: number }) {
  return <div className="rounded-2xl border border-white/10 bg-slate-900 p-4"><div className="text-slate-400 text-sm">{title}</div><div className="mt-2 text-2xl font-black text-amber-300">{value.toLocaleString('fa-IR')}</div></div>;
}
function Action({ label, onClick, danger }: { label: string; onClick: () => void; danger?: boolean }) {
  return <button onClick={onClick} className={`rounded-lg px-3 py-1.5 text-xs font-bold ${danger ? 'bg-red-500/20 text-red-200' : 'bg-white/10 text-white hover:bg-amber-400 hover:text-slate-950'}`}>{label}</button>;
}