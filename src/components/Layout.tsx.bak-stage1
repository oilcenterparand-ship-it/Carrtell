import AdminTopBar from '../admin/components/AdminTopBar';
import ThemeModeToggle from './ThemeModeToggle';
import { brandConfig } from '../config/brand';
import { useState, useEffect, useRef } from 'react';
import { Link, useLocation } from 'react-router-dom';
import { getProductCategories, type ProductCategory } from '../admin/services/categoriesApi';
import { onSelectedCustomerCarChange, readSelectedCustomerCar } from '../customer/services/selectedCar';
import { useAuth } from '../auth/AuthProvider';
import {
  Menu,
  X,
  Phone,
  Search,
  User,
  Car,
  CalendarDays,
  Home,
  Grid3X3,
  ChevronDown,
  ShieldCheck,
  Wrench,
  LogOut,
} from 'lucide-react';
import MiniCart from './MiniCart';

const navLinks = [
  { to: '/', label: 'خانه' },
  { to: '/shop', label: 'فروشگاه' },
  { to: '/book', label: 'رزرو سرویس' },
  { to: '/dashboard', label: 'پنل کاربری' },
  { to: '/investor', label: 'سرمایه‌گذاری' },
];

function CarrtellLogo() {
  return (
    <Link to="/" className="flex items-center shrink-0">
      <img src={brandConfig.logo} alt={brandConfig.name} className="h-11 w-auto object-contain" />
    </Link>
  );
}

export default function Header() {
  const [scrolled, setScrolled] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [categoriesOpen, setCategoriesOpen] = useState(false);
  const [categories, setCategories] = useState<ProductCategory[]>([]);
  const [selectedCustomerCar, setSelectedCustomerCar] = useState(() => readSelectedCustomerCar());
  const location = useLocation();
  const { role, user, signOut } = useAuth();
  const menuRef = useRef<HTMLDivElement | null>(null);
  const categoriesRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 10);
    window.addEventListener('scroll', onScroll);
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  useEffect(() => {
    setMobileOpen(false);
    setCategoriesOpen(false);
  }, [location.pathname]);

  useEffect(() => {
    function handleOutsideClick(event: MouseEvent) {
      const target = event.target as Node;
      if (mobileOpen && menuRef.current && !menuRef.current.contains(target)) {
        setMobileOpen(false);
      }
      if (categoriesOpen && categoriesRef.current && !categoriesRef.current.contains(target)) {
        setCategoriesOpen(false);
      }
    }
    document.addEventListener('mousedown', handleOutsideClick);
    return () => document.removeEventListener('mousedown', handleOutsideClick);
  }, [mobileOpen, categoriesOpen]);

  useEffect(() => {
    const unsubscribe = onSelectedCustomerCarChange(() => setSelectedCustomerCar(readSelectedCustomerCar()));
    return unsubscribe;
  }, []);

  useEffect(() => {
    let mounted = true;
    getProductCategories()
      .then((data) => {
        if (mounted) setCategories((data || []).filter((item) => item.is_active !== false));
      })
      .catch(() => setCategories([]));
    return () => {
      mounted = false;
    };
  }, []);

  const roleShortcut = role === 'admin'
    ? { to: '/admin', label: 'پنل مدیریت', icon: ShieldCheck }
    : role === 'driver'
      ? { to: '/driver', label: 'پنل سرویس‌کار', icon: Wrench }
      : null;
  const RoleIcon = roleShortcut?.icon;

  return (
    <header
      className={`fixed top-0 right-0 left-0 z-50 text-white transition-all duration-300 ${
        scrolled ? 'bg-neutral-950/98 backdrop-blur-xl shadow-lg shadow-black/30' : 'bg-neutral-950/95 backdrop-blur-xl'
      }`}
      dir="rtl"
    >
      <div className="border-b border-white/10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center gap-3">
          <CarrtellLogo />

          <Link to="/dashboard#vehicles" className="hidden lg:flex max-w-[230px] items-center gap-2 rounded-xl bg-neutral-900 px-4 py-2.5 font-bold text-white transition hover:bg-neutral-800">
            <Car className="w-5 h-5 shrink-0 text-gold-500" />
            <span className="truncate">{selectedCustomerCar?.title || 'خودروی من'}</span>
          </Link>

          <div className="hidden md:flex flex-1 items-center gap-3 rounded-xl bg-neutral-900 border border-white/10 px-4 py-2.5 focus-within:border-gold-400 transition">
            <Search className="w-5 h-5 text-neutral-400" />
            <input
              className="w-full bg-transparent outline-none text-sm text-white placeholder:text-neutral-400"
              placeholder="جستجوی روغن، فیلتر، برند یا خودرو..."
            />
          </div>

          <div className="hidden md:flex items-center gap-2">
            <a
              href="tel:0219130"
              className="hidden xl:flex items-center gap-2 rounded-xl border border-white/15 px-3 py-2.5 text-sm font-bold text-neutral-200 hover:border-gold-400 hover:text-neutral-950 transition"
            >
              <Phone className="w-4 h-4" />
              ۰۲۱-۹۱۳۰
            </a>

            <Link
              to="/"
              className="h-10 w-10 rounded-xl border border-white/15 flex items-center justify-center hover:border-gold-400 hover:bg-white/10 transition"
              aria-label="خانه"
            >
              <Home className="w-5 h-5" />
            </Link>

            {roleShortcut && RoleIcon && (
              <Link
                to={roleShortcut.to}
                className="hidden xl:inline-flex h-12 items-center gap-2 rounded-2xl border border-gold-300 bg-gold-50 px-4 text-sm font-black text-neutral-950 hover:bg-gold-100 transition"
                aria-label={roleShortcut.label}
              >
                <RoleIcon className="w-5 h-5" />
                {roleShortcut.label}
              </Link>
            )}

            <Link
              to="/dashboard"
              className="h-10 w-10 rounded-xl border border-white/15 flex items-center justify-center hover:border-gold-400 hover:bg-white/10 transition"
              aria-label={user?.phone ? 'پروفایل کاربری' : 'ورود / پروفایل کاربری'}
            >
              <User className="w-5 h-5" />
            </Link>

            {user && (
              <button
                onClick={() => void signOut()}
                className="h-10 w-10 rounded-xl border border-white/15 flex items-center justify-center hover:border-red-400 hover:bg-red-50 hover:text-red-700 transition"
                aria-label="خروج"
              >
                <LogOut className="w-5 h-5" />
              </button>
            )}

            <ThemeModeToggle />
            <MiniCart />

            <Link
              to="/book"
              className="h-10 rounded-xl bg-gold-500 px-4 flex items-center gap-2 font-black text-neutral-950 hover:bg-gold-400 transition shadow-lg shadow-gold-500/20"
            >
              <CalendarDays className="w-5 h-5" />
              رزرو سرویس
            </Link>
          </div>

          <button
            onClick={() => setMobileOpen((prev) => !prev)}
            className="xl:hidden mr-auto h-10 w-10 rounded-xl border border-white/15 flex items-center justify-center hover:bg-neutral-100 transition"
            aria-label="منو"
          >
            {mobileOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
          </button>
        </div>
      </div>

      <div className="hidden xl:block border-b border-white/10 bg-neutral-900/95">
        <div className="mx-auto flex h-11 max-w-7xl items-center gap-2 overflow-x-auto px-4 sm:px-6 lg:px-8">
          <button
            onMouseEnter={() => setCategoriesOpen(true)}
            onClick={() => setCategoriesOpen((v) => !v)}
            className="flex shrink-0 items-center gap-2 rounded-lg bg-gold-500 px-3 py-2 text-sm font-black text-neutral-950 transition hover:bg-gold-400"
          >
            <Grid3X3 className="h-4 w-4" />
            همه دسته‌بندی‌ها
            <ChevronDown className="h-4 w-4" />
          </button>

          <Link to="/shop" className="shrink-0 rounded-lg px-3 py-2 text-sm font-bold text-white/90 hover:bg-white/10 hover:text-gold-300">
            همه محصولات
          </Link>

          {categories.slice(0, 8).map((category) => (
            <Link
              key={category.id || category.slug}
              to={`/shop?category=${category.slug}`}
              className="shrink-0 rounded-lg px-3 py-2 text-sm font-bold text-white/75 transition hover:bg-white/10 hover:text-gold-300"
            >
              {category.title}
            </Link>
          ))}
        </div>
      </div>

      {categoriesOpen && (
        <div
          ref={categoriesRef}
          onMouseLeave={() => setCategoriesOpen(false)}
          className="hidden xl:block absolute right-6 top-[108px] z-[9999] w-[360px] overflow-hidden rounded-3xl border border-neutral-200 bg-white shadow-2xl shadow-black/15"
        >
          <div className="flex items-center justify-between border-b border-white/10 px-4 py-3">
            <b>دسته‌بندی‌ها</b>
            <button onClick={() => setCategoriesOpen(false)} className="rounded-xl bg-neutral-100 p-2"><X className="h-4 w-4" /></button>
          </div>
          <div className="max-h-[430px] overflow-y-auto p-3">
            <Link to="/shop" className="mb-2 block rounded-2xl bg-gold-500 px-4 py-3 text-sm font-black text-neutral-950">
              همه محصولات
            </Link>
            <div className="grid gap-2">
              {categories.map((category) => (
                <Link
                  key={category.id || category.slug}
                  to={`/shop?category=${category.slug}`}
                  className="flex items-center justify-between rounded-2xl bg-neutral-50 px-4 py-3 text-sm font-bold text-neutral-800 hover:bg-neutral-100"
                >
                  <span>{category.title}</span>
                  <span className="text-xs text-neutral-400">{category.slug}</span>
                </Link>
              ))}
            </div>
          </div>
        </div>
      )}

      {mobileOpen && (
        <div ref={menuRef} className="xl:hidden absolute left-4 top-20 z-[9999] w-[min(360px,calc(100vw-32px))] overflow-hidden rounded-3xl border border-white/10 bg-neutral-950 text-white shadow-2xl shadow-black/30">
          <div className="flex items-center justify-between border-b border-white/10 px-4 py-3">
            <b className="text-white">منوی سریع</b>
            <button onClick={() => setMobileOpen(false)} className="rounded-xl bg-white/10 p-2" aria-label="بستن منو">
              <X className="h-4 w-4" />
            </button>
          </div>
          <div className="max-h-[70vh] overflow-y-auto p-4 space-y-3">
            <div className="flex items-center gap-3 rounded-2xl bg-white/10 border border-white/10 px-4 py-3">
              <Search className="w-5 h-5 text-neutral-400" />
              <input className="w-full bg-transparent outline-none text-sm text-white placeholder:text-white/50" placeholder="جستجو..." />
            </div>

            <Link to="/dashboard#vehicles" className="w-full flex items-center justify-center gap-2 rounded-2xl bg-neutral-950 text-white px-5 py-3 font-bold">
              <Car className="w-5 h-5 text-gold-500" />
              <span className="truncate">{selectedCustomerCar?.title || 'انتخاب خودروی من'}</span>
            </Link>

            <button
              onClick={() => setCategoriesOpen((v) => !v)}
              className="w-full flex items-center justify-between rounded-2xl bg-gold-500 px-4 py-3 text-sm font-black text-neutral-950"
            >
              <span className="flex items-center gap-2"><Grid3X3 className="h-5 w-5" /> دسته‌بندی‌ها</span>
              <ChevronDown className={`h-4 w-4 transition ${categoriesOpen ? 'rotate-180' : ''}`} />
            </button>

            {categoriesOpen && (
              <div className="max-h-64 overflow-y-auto rounded-2xl border border-white/10 bg-white/5 p-2">
                <Link to="/shop" className="block rounded-xl px-3 py-2 text-sm font-bold text-white hover:bg-white/10">همه محصولات</Link>
                {categories.map((category) => (
                  <Link
                    key={category.id || category.slug}
                    to={`/shop?category=${category.slug}`}
                    className="block rounded-xl px-3 py-2 text-sm font-bold text-white/80 hover:bg-white/10"
                  >
                    {category.title}
                  </Link>
                ))}
              </div>
            )}

            {roleShortcut && RoleIcon && (
              <Link to={roleShortcut.to} className="flex items-center justify-center gap-2 rounded-2xl border border-gold-400/40 bg-gold-500 px-4 py-3 text-sm font-black text-neutral-950 shadow-lg shadow-gold-500/20">
                <RoleIcon className="h-5 w-5" />
                {roleShortcut.label}
              </Link>
            )}

            {user && (
              <button onClick={() => void signOut()} className="flex items-center justify-center gap-2 rounded-2xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm font-black text-red-100">
                <LogOut className="h-5 w-5" /> خروج از حساب
              </button>
            )}

            <nav className="grid gap-2">
              {navLinks.map((link) => (
                <Link
                  key={link.to}
                  to={link.to}
                  className={`block px-4 py-3 rounded-2xl text-sm font-bold shadow-sm ${
                    location.pathname === link.to ? 'text-neutral-950 bg-gold-500' : 'text-white bg-white/10 hover:bg-white/15'
                  }`}
                >
                  {link.label}
                </Link>
              ))}
            </nav>
          </div>
        </div>
      )}
    </header>
  );
}
