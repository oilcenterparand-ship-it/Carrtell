{
    "name": "vite-react-typescript-starter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "qa": " node scripts/qa-agent.mjs",
        "qa:e2e": "playwright test",
        "qa:e2e:mobile": "playwright test --project=mobile-iphone",
        "qa:full": "npm run typecheck; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run lint; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run qa:e2e",
        "qa:personas": "playwright test -c playwright.persona.config.ts",
        "qa:persona:customer": "playwright test tests/e2e/persona-customer.spec.ts -c playwright.persona.config.ts",
        "qa:persona:visual": "playwright test tests/e2e/persona-customer.spec.ts -c playwright.persona.config.ts --project=android-chrome",
        "qa:persona:admin": "playwright test tests/e2e/persona-admin.spec.ts -c playwright.persona.config.ts",
        "qa:persona:technician": "playwright test tests/e2e/persona-technician.spec.ts -c playwright.persona.config.ts"
    },
    "dependencies": {
        "@neshan-maps-platform/maplibre-sdk": "^5.24.4",
        "@supabase/supabase-js": "^2.108.2",
        "kavenegar": "^1.1.4",
        "lucide-react": "^0.344.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.17.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@playwright/test": "^1.62.1",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.18",
        "eslint": "^9.9.1",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "globals": "^15.9.0",
        "postcss": "^8.4.35",
        "supabase": "^2.114.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.3.0",
        "vite": "^5.4.2"
    }
}
